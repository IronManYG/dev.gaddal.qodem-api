<configuration>
    <!-- Define the base directory for log files -->
    <property name="LOG_PATH" value="logs" />

    <!-- Define the directory for archived log files -->
    <property name="LOG_ARCHIVE" value="${LOG_PATH}/archive" />

    <!-- Console Appender -->
    <!-- Outputs logs to the console -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <!-- Using full package names as seen in your logs -->
<!--            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger) - %msg%n</pattern>-->

            <!-- For abbreviated package names, uncomment the line below and comment out the line above -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

<!--    &lt;!&ndash; Rolling File Appender &ndash;&gt;-->
