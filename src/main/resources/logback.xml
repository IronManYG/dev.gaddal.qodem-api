<!--        <discardingThreshold>0</discardingThreshold>-->
<!--    </appender>-->

    <!-- Logger configurations for specific packages -->
    <!-- Sets the logging level to INFO for Jetty and Netty packages -->
    <logger name="org.eclipse.jetty" level="INFO" />
    <logger name="io.netty" level="INFO" />

    <!-- Logger configuration for your Kotlin package -->
    <!-- Adjust the package name to match your application -->
    <logger name="dev.gaddal" level="DEBUG" />

    <!-- Root logger configuration -->
    <!-- Logs at the INFO level by default and uses the CONSOLE and ASYNC appenders -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
<!--        <appender-ref ref="ASYNC" />-->
    </root>
</configuration>
